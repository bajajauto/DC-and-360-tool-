{
  "name": "dc-tool-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node server/src/index.js",
    "client:dev": "vite",
    "server:dev": "node server/src/index.js",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js",
    "db:import-hr": "node server/prisma/importHrData.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.17.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "prisma": "^6.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "postcss": "^8",
    "tailwindcss": "^4",
    "vite": "^8.1.4"
  }
}
